<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>雷達規劃器 Production v2</title>
<style>
body{margin:0;background:#111;color:#eee;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans TC",sans-serif;padding:18px}
h1{font-size:25px;margin:0 0 8px}.desc{color:#aaa;line-height:1.55;margin-bottom:18px}
.card{background:#1d1d1d;border:1px solid #333;border-radius:14px;padding:15px;margin:12px 0}
h2{font-size:19px;margin:0 0 12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label{display:block;color:#bbb;font-size:14px;margin-bottom:5px}
input,select{width:100%;box-sizing:border-box;background:#292929;color:#fff;border:1px solid #444;border-radius:9px;padding:10px;font-size:16px}
button{font-size:17px;font-weight:700;padding:12px 18px;border:0;border-radius:11px;background:#1683ff;color:#fff}
.row{display:flex;gap:9px;flex-wrap:wrap}.result{font-size:17px;line-height:1.65}
.good{color:#20d879}.warn{color:#ffc44d}.bad{color:#ff5964}.big{font-size:23px;font-weight:800}.muted{color:#aaa}
hr{border:0;border-top:1px solid #333;margin:14px 0}
ol,ul{margin:8px 0;padding-left:24px}li{margin:7px 0}
.small{font-size:14px}.pill{display:inline-block;padding:4px 8px;border-radius:8px;background:#292929;margin:2px 4px 2px 0}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<h1>雷達規劃器</h1>
<div class="desc">Production v2｜使用已確認的雷達規則計算理想狀態、衝分日與操作順序。規劃只產生建議，不會直接修改玩家狀態。</div>

<div class="card">
<h2>① 目前狀態</h2>
<div class="grid">
<div><label>庫存 MAX</label><input id="maxInventory" type="number" min="1" value="30"></div>
<div><label>庫存</label><input id="inventory" type="number" min="0" value="22"></div>
<div><label>場上雷達總數</label><input id="field" type="number" min="0" value="11"></div>
<div><label>其中已完成</label><input id="completed" type="number" min="0" value="8"></div>
<div><label>Laura 星級</label><select id="lauraStar"><option value="0">0 星</option><option value="1">1 星</option><option value="2">2 星</option><option value="3">3 星</option><option value="4" selected>4 星</option><option value="5">5 星</option></select></div>
<div><label>Laura 今日狀態</label><select id="lauraUsed"><option value="false">尚未使用</option><option value="true">今日已使用</option></select></div>
<div><label>5 星寶藏</label><input id="treasure" type="number" min="0" max="10" value="0"></div>
<div><label>時間顯示</label><select id="timeMode"><option value="local">當地時間</option><option value="doom">末日時間（UTC−2）</option></select></div>
</div>
</div>

<div class="card">
<h2>② 每日任務</h2>
<div class="grid">
<div><label>勇士戰令</label><select id="warActive"><option value="false">未啟用</option><option value="true">啟用</option></select></div>
<div><label>勇士戰令目標</label><input id="warTarget" type="number" min="0" value="20"></div>
<div><label>勇士戰令目前進度</label><input id="warCurrent" type="number" min="0" value="0"></div>
<div><label>黎明曙光</label><select id="dawnActive"><option value="false">未啟用</option><option value="true">啟用</option></select></div>
<div><label>黎明曙光目標</label><input id="dawnTarget" type="number" min="0" value="20"></div>
<div><label>黎明曙光目前進度</label><input id="dawnCurrent" type="number" min="0" value="0"></div>
</div>
</div>

<div class="card">
<h2>③ 規劃時間</h2>
<div class="grid">
<div><label>計算基準時間</label><input id="baseTime" type="datetime-local"></div>
<div><label>規劃日期判斷</label><div id="timeInfo" class="muted">尚未規劃</div></div>
</div>
<div class="row" style="margin-top:12px">
<button id="now">使用現在時間</button>
<button id="plan">開始規劃</button>
</div>
</div>

<div id="output" class="card">
<h2>規劃結果</h2>
<div class="muted">尚未執行規劃。</div>
</div>

<script>
const $=id=>document.getElementById(id);
const LAURA={0:5,1:10,2:10,3:10,4:20,5:20};
function clone(x){return JSON.parse(JSON.stringify(x));}
function makeState(){
 return {
  field:+$("field").value, completed:+$("completed").value,
  inventory:+$("inventory").value, maxInventory:+$("maxInventory").value,
  lauraStar:+$("lauraStar").value, lauraUsed:$("lauraUsed").value==="true",
  treasure:Math.min(10,Math.max(0,+$("treasure").value)),
  tasks:{
   warriors:{active:$("warActive").value==="true",target:+$("warTarget").value,current:+$("warCurrent").value},
   dawn:{active:$("dawnActive").value==="true",target:+$("dawnTarget").value,current:+$("dawnCurrent").value}
  }
 };
}
function normalize(s){s=clone(s);s.unfinished=s.field-s.completed;return s;}
function ideal(max){return {field:11,inventory:max-8};}
function complete(s,n=1){
 s=clone(s);
 for(let i=0;i<n&&s.unfinished>0;i++){
  s.unfinished--;s.completed++;
  for(const k of ["warriors","dawn"]){
   const t=s.tasks[k];if(t&&t.active)t.current=Math.min(t.target,t.current+1);
  }
 }
 return s;
}
function harvest(s,n=1){
 s=clone(s);
 for(let i=0;i<n&&s.completed>0;i++){
  s.completed--;s.field--;
  if(s.lauraStar===5&&s.treasure<10)s.treasure++;
  if(s.field<8&&s.inventory>0){
   const add=Math.min(8-s.field,s.inventory);
   s.field+=add;s.inventory-=add;
  }
 }
 s.unfinished=s.field-s.completed;return s;
}
function system8(s){
 s=clone(s);
 const fieldAdd=Math.min(8,Math.max(0,8-s.field));
 s.field+=fieldAdd;
 const rem=8-fieldAdd;
 s.inventory+=Math.min(rem,Math.max(0,s.maxInventory-s.inventory));
 s.unfinished=s.field-s.completed;return s;
}
function laura(s){
 s=clone(s);if(s.lauraUsed)return s;
 const amount=LAURA[s.lauraStar];
 if(s.field<8){
  const add=Math.min(8-s.field,amount);
  s.field+=add;s.inventory+=amount-add;
 }else{
  s.field+=3;s.inventory+=amount-3;
 }
 s.lauraUsed=true;s.unfinished=s.field-s.completed;return s;
}
function validate(s){
 const e=[];
 if(s.maxInventory<=0)e.push("庫存 MAX 必須大於 0");
 if(s.inventory<0)e.push("庫存不可小於 0");
 if(s.field<0)e.push("場上雷達總數不可小於 0");
 if(s.completed<0)e.push("已完成數不可小於 0");
 if(s.completed>s.field)e.push("已完成數不可大於場上總數");
 for(const k of ["warriors","dawn"]){
  const t=s.tasks[k];
  if(t.target<0||t.current<0)e.push("每日任務數值不可小於 0");
 }
 return e;
}

/* Taiwan game-day:
   10:00 Taiwan = new game day. Before 10:00 belongs to the previous game date.
   Monday/Friday 10:00 are scoring points.
*/
function gameDayDate(base){
 const d=new Date(base);
 const parts=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Taipei",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",hour12:false}).formatToParts(d);
 const o={};parts.forEach(p=>o[p.type]=p.value);
 let x=new Date(Date.UTC(+o.year,+o.month-1,+o.day));
 if(+o.hour<10)x.setUTCDate(x.getUTCDate()-1);
 return x;
}
function taipeiHour(base){
 const parts=new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Taipei",hour:"2-digit",hour12:false}).formatToParts(new Date(base));
 return +(parts.find(x=>x.type==="hour").value);
}
function weekdayUTCDate(d){return d.getUTCDay();}
function taipeiDateTime(dateUTCday,hour){
 // Convert a Taiwan calendar date + hour to an absolute Date.
 // Taiwan is UTC+8.
 return new Date(Date.UTC(dateUTCday.getUTCFullYear(),dateUTCday.getUTCMonth(),dateUTCday.getUTCDate(),hour-8,0,0));
}
function nextScoring(base){
 const gd=gameDayDate(base);
 const h=taipeiHour(base);
 for(let i=0;i<14;i++){
  const d=new Date(gd.getTime()+i*86400000);
  const w=weekdayUTCDate(d);
  if((w===1||w===5) && (i>0 || h<10))return taipeiDateTime(d,10);
 }
 return taipeiDateTime(new Date(gd.getTime()+14*86400000),10);
}
function modeText(base){
 const gd=gameDayDate(base), w=weekdayUTCDate(gd), h=taipeiHour(base);
 if((w===1||w===5)&&h>=10)return "衝分日";
 if((w===1||w===5)&&h<10)return "衝分日前準備";
 return "準備期";
}
function nextSystemEvent(base){
 const d=new Date(base);
 const candidates=[];
 for(let i=0;i<3;i++){
  const x=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()+i,2,0,0));
  candidates.push(x);
  candidates.push(new Date(x.getTime()+8*3600000));
  candidates.push(new Date(x.getTime()+16*3600000));
 }
 return candidates.filter(x=>x.getTime()>d.getTime()).sort((a,b)=>a-b)[0];
}
function fmt(d){
 const mode=$("timeMode").value;
 return new Intl.DateTimeFormat("zh-TW",{timeZone:mode==="doom"?"Etc/GMT+2":"Asia/Taipei",hour12:false,year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit"}).format(new Date(d));
}
function scoringLabel(d){
 return fmt(d);
}

/* Build a conservative, deterministic operation sequence.
   It never assumes ally instant help and never assumes an unfinished radar expires early.
   Completing changes unfinished -> completed and advances active tasks; it does not change field.
   Harvesting changes field/inventory only through the confirmed auto-refill rule.
*/
function buildPreparationPlan(original,base){
 let s=normalize(original), steps=[], target=ideal(s.maxInventory);

 // Complete all currently unfinished radars when preparing a scoring day if active tasks need progress.
 // If no active task needs progress, completion is still allowed but not required for resource preparation.
 const activeNeed=Object.values(s.tasks).some(t=>t.active&&t.current<t.target);
 if(s.unfinished>0&&activeNeed){
  const n=s.unfinished;s=complete(s,n);
  steps.push(`完成目前 ${n} 個未完成雷達：場上總數不變為 ${s.field}，已完成變為 ${s.completed}。`);
 }

 // Laura is the known one-click-per-day source. Use it before waiting when field is below 11
 // or inventory is below the ideal target, because it can add resources immediately.
 if(!s.lauraUsed&&(s.field<target.field||s.inventory<target.inventory)){
  const before=clone(s);s=laura(s);
  steps.push(`使用 ${s.lauraStar} 星 Laura：場上 ${before.field}→${s.field}、庫存 ${before.inventory}→${s.inventory}。`);
 }

 // Known system +8 events are simulated only as future resource entries.
 let guard=0;
 while((s.field<target.field||s.inventory<target.inventory)&&guard<12){
  const ev=nextSystemEvent(base);
  if(!ev)break;
  const before=clone(s);s=system8(s);
  const f=s.field-before.field, inv=s.inventory-before.inventory;
  steps.push(`等待系統 +8（${fmt(ev)}）：場上 +${f}、庫存 +${inv}。`);
  guard++;
  if(f===0&&inv===0)break;
 }

 const reached=s.field>=target.field&&s.inventory>=target.inventory;
 return {s,steps,reached,target};
}
function buildScoringPlan(original,base){
 let s=normalize(original),steps=[];
 if(s.unfinished>0){
  const n=s.unfinished;s=complete(s,n);
  steps.push(`先完成 ${n} 個未完成雷達：完成只改變完成狀態，不增加或減少場上總數。`);
 }
 if(!s.lauraUsed){
  const before=clone(s);s=laura(s);
  steps.push(`Laura 今日尚未使用，可安排使用：場上 ${before.field}→${s.field}、庫存 ${before.inventory}→${s.inventory}。`);
 }
 if(s.completed>0){
  const n=s.completed;s=harvest(s,n);
  steps.push(`收割 ${n} 個已完成雷達；每次收割後依規則在場上低於 8 時自動用庫存補回。`);
 }
 return {s,steps};
}
function scoringEstimatePrep(s){
 const lauraExtra=s.lauraUsed?0:LAURA[s.lauraStar];
 return s.field+s.inventory+24+lauraExtra;
}
function scoringEstimateCurrent(s,base){
 const d=new Date(base);
 let count=0;
 for(let i=0;i<3;i++){
  const x=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()+i,2,0,0));
  for(const ev of [x,new Date(x.getTime()+8*3600000),new Date(x.getTime()+16*3600000)]){
   if(ev> d && ev<=new Date(d.getTime()+24*3600000))count++;
  }
 }
 const lauraExtra=s.lauraUsed?0:LAURA[s.lauraStar];
 return s.field+s.inventory+count*8+lauraExtra;
}
function renderPlan(){
 const s=makeState(), errors=validate(s);
 if(errors.length){
  $("output").innerHTML=`<h2>規劃結果</h2><div class="bad">❌ 無法規劃</div><ul>${errors.map(e=>`<li>${e}</li>`).join("")}</ul>`;return;
 }
 const base=$("baseTime").value?new Date($("baseTime").value):new Date();
 const mode=modeText(base), score=nextScoring(base), target=ideal(s.maxInventory);
 let html=`<h2>規劃結果</h2><div class="big">${mode}</div>`;
 html+=`<div class="muted">計算基準：${fmt(base)}<br>下一個衝分時間：${fmt(score)}<br>下一次系統 +8：${fmt(nextSystemEvent(base))}</div><hr>`;
 html+=`<div><b>理想狀態</b></div><div class="result">場上：<b>${target.field}</b> 個<br>庫存：<b>${target.inventory}</b> 個</div>`;

 if(mode==="衝分日"){
  const p=buildScoringPlan(s,base);
  const estimate=scoringEstimateCurrent(s,base);
  html+=`<div class="result" style="margin-top:12px"><b>目前狀態</b><br>場上 ${s.field}／已完成 ${s.completed}／庫存 ${s.inventory}</div>`;
  html+=`<div class="card"><div class="big">🏆 目前往後預計可收割：約 ${estimate} 個</div><div class="muted">以目前狀態＋接下來 24 小時內尚未發生的系統 +8＋尚未使用的 Laura 計算；不預設盟友瞬間幫助。</div></div>`;
  html+=`<div class="result"><b>衝分日操作順序</b><ol>`;
  p.steps.forEach(x=>html+=`<li>${x}</li>`);
  html+=`<li><b>收割可收割的已完成雷達。</b>衝分日不需要為下一個衝分日保留資源。</li></ol></div>`;
  html+=`<div class="good"><b>原則：</b>完成事件計入啟用中的每日任務；收割本身不增加任務進度。5 星 Laura 的寶藏每收割 1 個 +1，當日最多 10。</div>`;
 }else{
  const p=buildPreparationPlan(s,base);
  html+=`<div class="result" style="margin-top:12px"><b>目前狀態</b><br>場上 ${s.field}／未完成 ${s.field-s.completed}／已完成 ${s.completed}／庫存 ${s.inventory}</div>`;
  if(p.reached){
   html+=`<div class="good big" style="margin-top:12px">✅ 已達理想準備狀態</div>`;
  }else{
   html+=`<div class="warn big" style="margin-top:12px">🟡 目前尚未能靠已知來源直接達標</div>`;
  }
  html+=`<div class="result"><b>操作順序建議</b><ol>`;
  if(p.steps.length===0)html+=`<li>目前沒有需要執行的資源準備操作。</li>`;
  p.steps.forEach(x=>html+=`<li>${x}</li>`);
  html+=`</ol></div>`;
  html+=`<div class="card"><div><b>操作後預估</b></div><div class="result">場上：<b>${p.s.field}</b> 個<br>庫存：<b>${p.s.inventory}</b> 個</div></div>`;
  if(p.reached)html+=`<div class="good">完成上述步驟後，預計可達理想準備狀態。</div>`;
  else html+=`<div class="warn">完成目前可計算的已知來源後仍不足；到下一個時間點再按「開始規劃」，用最新狀態重新計算。</div>`;
 }
 html+=`<hr><div class="small muted">保守基準：不預設盟友瞬間幫助；不預測目前未完成雷達提前消失；自動補回是庫存→場上的移動，不算新增資源。</div>`;
 $("output").innerHTML=html;
 $("timeInfo").textContent=`${mode}｜基準 ${fmt(base)}`;
}
$("now").onclick=()=>{
 const d=new Date(),p=n=>String(n).padStart(2,"0");
 $("baseTime").value=`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
 $("timeInfo").textContent="已更新為現在時間";
};
$("plan").onclick=renderPlan;
$("timeMode").onchange=()=>{
 $("timeInfo").textContent="顯示："+($("timeMode").value==="doom"?"末日時間（UTC−2）":"當地時間");
};
$("now").click();
</script>
</body>
</html>